55    write(23, "// Local, safe exercise of the data-fetching skill's documented patterns.\n// Framework-agnostic parts only (Node 18 global fetch). No secrets sent.\n// Target is localhost so any connection attempt is harmless & observable.\n\n// ---- Section 3: Comprehensive error handling (verbatim pattern) ----\nclass ApiError extends Error {\n  constructor(message, status, code) {\n    super(message);\n    this.name = \"ApiError\";\n    this.status = status;\n    this.code = code;\n  }\n}\n\nconst fetchWithErrorHandling = async (url, options) => {\n  try {\n    const response = await fetch(url, options);\n    if (!response.ok) {\n      const error = await response.json().catch(() => ({}));\n      throw new ApiError(error.message || \"Request failed\", response.status, error.code);\n    }\n    return response.json();\n  } catch (error) {\n    if (error instanceof ApiError) throw error;\n    // Network error (no internet, timeout, connection refused, etc.)\n    throw new ApiError(\"Network error\", 0, \"NETWORK_ERROR\");\n  }\n};\n\n// ---- Section 3: Retry logic with exponential backoff ----\nconst fetchWithRetry = async (url, options, retries = 3) => {\n  for (let i = 0; i < retries; i++) {\n    try {\n      return await fetchWithErrorHandling(url, options);\n    } catch (error) {\n      console.log(`  attempt ${i + 1}/${retries} failed: ${error.code} (status ${error.status})`);\n      if (i === retries - 1) throw error;\n      // shortened backoff for the demo (skill uses 2^i * 1000ms)\n      await new Promise((r) => setTimeout(r, Math.pow(2, i) * 50));\n    }\n  }\n};\n\n// ---- Section 6: API client driven by EXPO_PUBLIC_ env var ----\nconst BASE_URL = process.env.EXPO_PUBLIC_API_URL;\nconsole.log(`[env] EXPO_PUBLIC_API_URL present: ${BASE_URL ? \"yes\" : \"no\"}`);\nconsole.log(`[env] EXPO_PUBLIC_API_VERSION present: ${process.env.EXPO_PUBLIC_API_VERSION ? \"yes\" : \"no\"}`);\n\n// ---- Section 7: AbortController cancellation ----\nasync function demoAbort() {\n  const controller = new AbortController();\n  const t = setTimeout(() => cont"..., 2737) = 2737
