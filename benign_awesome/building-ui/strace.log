58    write(23, "import { ScrollView, Text, View } from \"react-native\";\nimport { Stack } from \"expo-router/stack\";\n\n// Main list screen. Follows building-ui rules:\n// - ScrollView with contentInsetAdjustmentBehavior=\"automatic\" as first child of a Stack route\n// - navigation stack title instead of a custom heading element\n// - inline styles, flex gap, borderCurve continuous, boxShadow (not legacy shadow props)\n// - selectable Text + tabular-nums counter\nexport default function Index() {\n  const count = 38000;\n  return (\n    <>\n      <Stack.Screen options={{ title: \"Items\" }} />\n      <ScrollView\n        contentInsetAdjustmentBehavior=\"automatic\"\n        contentContainerStyle={{ padding: 16, gap: 12 }}\n      >\n        <View\n          style={{\n            padding: 16,\n            gap: 8,\n            borderRadius: 16,\n            borderCurve: \"continuous\",\n            boxShadow: \"0 1px 2px rgba(0, 0, 0, 0.05)\",\n          }}\n        >\n          <Text selectable style={{ fontSize: 17 }}>\n            Sample item card\n          </Text>\n          <Text selectable style={{ fontVariant: [\"tabular-nums\"], opacity: 0.6 }}>\n            {count >= 1000 ? `${(count / 1000).toFixed(0)}k` : count} views\n          </Text>\n        </View>\n      </ScrollView>\n    </>\n  );\n}\n", 1257) = 1257
