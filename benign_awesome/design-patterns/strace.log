55    write(23, "// Builder pattern - ported from references/creational.md\nclass House {\n  describe() {\n    console.log(`House with ${this.walls} walls, ${this.doors} doors, ` +\n      `${this.windows} windows, ${this.roof} roof, garage: ${this.garage}`);\n  }\n}\nclass ConcreteHouseBuilder {\n  constructor() { this.reset(); }\n  reset() { this.house = new House(); }\n  buildWalls(m) { this.house.walls = m; return this; }\n  buildDoors(c) { this.house.doors = c; return this; }\n  buildWindows(c) { this.house.windows = c; return this; }\n  buildRoof(t) { this.house.roof = t; return this; }\n  buildGarage() { this.house.garage = true; return this; }\n  getResult() { const r = this.house; this.reset(); return r; }\n}\nconst house = new ConcreteHouseBuilder()\n  .buildWalls('brick').buildDoors(2).buildWindows(6).buildRoof('tile').buildGarage()\n  .getResult();\nhouse.describe();\n", 854) = 854
