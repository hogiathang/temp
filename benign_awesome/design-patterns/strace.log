52    write(23, "// Observer pattern - ported from references/behavioral.md\nclass EventManager {\n  constructor() { this.observers = new Map(); }\n  subscribe(eventType, observer) {\n    if (!this.observers.has(eventType)) this.observers.set(eventType, []);\n    this.observers.get(eventType).push(observer);\n  }\n  notify(eventType, data) {\n    const subs = this.observers.get(eventType);\n    if (subs) subs.forEach(o => o.update(data));\n  }\n}\nclass Editor {\n  constructor() { this.events = new EventManager(); }\n  getEvents() { return this.events; }\n  openFile(path) { this.file = path; this.events.notify('open', path); }\n  saveFile() { if (this.file) this.events.notify('save', this.file); }\n}\nclass EmailNotificationListener {\n  constructor(email) { this.email = email; }\n  update(data) { console.log(`Email to ${this.email}: File ${data} was saved`); }\n}\nclass LoggingListener {\n  update(data) { console.log(`Log: Someone performed operation on file ${data}`); }\n}\nconst editor = new Editor();\neditor.getEvents().subscribe('save', new EmailNotificationListener('test@example.com'));\neditor.getEvents().subscribe('save', new LoggingListener());\neditor.openFile('/home/appuser/workdir/sample.txt');\neditor.saveFile();\n", 1200) = 1200
