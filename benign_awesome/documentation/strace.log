55    write(23, "class UserService:\n    \"\"\"Service layer for user creation and lookup.\n\n    Wraps a repository to persist and retrieve user records.\n    \"\"\"\n\n    def __init__(self, repository):\n        \"\"\"Initialize the service.\n\n        :param repository: Persistence backend exposing ``save`` and ``find_by_id``.\n        \"\"\"\n        self.repository = repository\n\n    def create(self, command):\n        \"\"\"Create and persist a new user.\n\n        :param command: Mapping containing at least a ``name`` key.\n        :returns: The saved user record.\n\n        :example:\n        >>> service.create({\"name\": \"Test User\"})\n        \"\"\"\n        user = {\"id\": \"dummy-id\", \"name\": command[\"name\"]}\n        return self.repository.save(user)\n\n    def find_by_id(self, user_id):\n        \"\"\"Retrieve a user by identifier.\n\n        :param user_id: Unique identifier of the user.\n        :returns: The matching user record, or ``None`` if not found.\n        \"\"\"\n        return self.repository.find_by_id(user_id)\n", 980) = 980
