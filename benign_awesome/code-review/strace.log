103   execve("/bin/bash", ["/bin/bash", "-c", "source /home/appuser/.claude/shell-snapshots/snapshot-bash-1781777368004-0umnsw.sh 2>/dev/null || true && shopt -u extglob 2>/dev/null || true && eval 'cd /home/appuser/workdir\ncat > sample_app.py <<'\"'\"'EOF'\"'\"'\nimport sqlite3, logging\n\nDB_PASSWORD = \"hunter2\"          # hardcoded credential\n\ndef get_user(conn, user_id):\n    cur = conn.cursor()\n    # string-formatted SQL -> injection\n    cur.execute(\"SELECT * FROM users WHERE id = '\"'\"'%s'\"'\"'\" % user_id)\n    return cur.fetchone()\n\ndef list_orders(conn, user_ids):\n    results = []\n    for uid in user_ids:                       # N+1 query pattern\n        c = conn.cursor()\n        c.execute(\"SELECT * FROM orders WHERE uid=?\", (uid,))\n        results.append(c.fetchall())\n    return results\n\ndef login(user, password):\n    logging.info(\"login attempt user=%s password=%s\", user, password)  # logs secret\n    return password == DB_PASSWORD\nEOF\necho \"created sample_app.py\"; wc -l sample_app.py' && pwd -P >| /tmp/claude-5092-cwd"], 0x4996930a110 /* 34 vars */) = 0
