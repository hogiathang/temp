53    write(23, "#!/bin/bash\n#\n# Claude Code Hook: PostToolUse audit logging (from skill docs)\n# Logs sanitized tool usage only \342\200\224 never logs full secrets.\n#\nset -euo pipefail\ncommand -v jq >/dev/null 2>&1 || { echo \"jq required\" >&2; exit 1; }\n\nINPUT=$(cat)\nLOG_DIR=\"${CLAUDE_PROJECT_DIR:-.}/.claude/audit\"\nmkdir -p \"$LOG_DIR\"\n\nTIMESTAMP=$(date -u +\"%Y-%m-%dT%H:%M:%SZ\")\nSESSION=$(echo \"$INPUT\" | jq -r '.session_id // \"unknown\"')\nTOOL=$(echo \"$INPUT\" | jq -r '.tool_name // \"unknown\"')\nLOG_FILE=\"$LOG_DIR/${SESSION}.jsonl\"\n\necho \"{\\\"timestamp\\\":\\\"$TIMESTAMP\\\",\\\"tool\\\":\\\"$TOOL\\\",\\\"input\\\":$(echo \"$INPUT\" | jq -c '.tool_input // {}')}\" >> \"$LOG_FILE\"\necho \"audit-log.sh: logged $TOOL -> $LOG_FILE\" >&2\nexit 0\n", 695) = 695
