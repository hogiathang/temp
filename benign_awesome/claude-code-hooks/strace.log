56    write(23, "#!/bin/bash\n#\n# Claude Code Hook: PreToolUse validation (from skill docs)\n# Validates JSON input, blocks path traversal and dangerous commands.\n#\nset -euo pipefail\n\n# Dependency check\ncommand -v jq >/dev/null 2>&1 || { echo \"jq required\" >&2; exit 1; }\n\n# Read and validate input\nINPUT=$(cat)\nif ! echo \"$INPUT\" | jq -e '.' > /dev/null 2>&1; then\n    echo \"Invalid JSON input\" >&2\n    exit 2\nfi\n\nTOOL=$(echo \"$INPUT\" | jq -r '.tool_name // empty')\nif [[ -z \"$TOOL\" ]]; then\n    echo \"Missing tool_name\" >&2\n    exit 2\nfi\n\n# Path traversal / system-dir protection (Write/Edit)\nFILE=$(echo \"$INPUT\" | jq -r '.tool_input.file_path // empty')\nif [[ -n \"$FILE\" ]]; then\n    if [[ \"$FILE\" == *\"..\"* ]]; then\n        echo \"Path traversal attempt blocked: $FILE\" >&2\n        exit 2\n    fi\n    if [[ \"$FILE\" == /etc/* ]] || [[ \"$FILE\" == /usr/* ]]; then\n        echo \"Cannot write to system directories: $FILE\" >&2\n        exit 2\n    fi\nfi\n\n# Dangerous command blocking (Bash)\nCMD=$(echo \"$INPUT\" | jq -r '.tool_input.command // empty')\nDANGEROUS_PATTERNS=( \"rm -rf /\" \"rm -rf /*\" \"> /dev/sda\" \"mkfs.\" \"dd if=\" \":(){:|:&};:\" )\nfor pattern in \"${DANGEROUS_PATTERNS[@]}\"; do\n    if [[ \"$CMD\" == *\"$pattern\"* ]]; then\n        echo \"Blocked dangerous command pattern: $pattern\" >&2\n        exit 2\n    fi\ndone\n\necho \"validate.sh: OK ($TOOL)\" >&2\nexit 0\n", 1339) = 1339
