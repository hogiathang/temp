urn '\"'\"'Negative not allowed'\"'\"'; // bug: msg mismatch + allows 0\n  return null;\n}\nEOF\n\necho \"=== created mock project tree ===\"\nfind /home/appuser/workdir/sample-e2e -type f' && pwd -P >| /tmp/claude-4883-cwd"], 0x3fc086ec090 /* 34 vars */) = 0
