56    write(23, "// ColorSample.tsx \342\200\224 generated by exercising the `handling-colors` skill.\n// Demonstrates correct ReactUMG color-type usage per the cheat sheet.\n// SlateColor = nested {SpecifiedColor:{R,G,B,A}}; LinearColor = direct {R,G,B,A}.\n\nimport * as React from \"react\";\nimport { TextBlock, Border, Image, Button } from \"react-umg\";\n\nexport function ColorSample() {\n    return (\n        <Border\n            // Border.BrushColor -> LinearColor (direct structure)\n            BrushColor={{ R: 0.05, G: 0.08, B: 0.1, A: 0.95 }}\n            // Border.ContentColorAndOpacity -> LinearColor (direct)\n            ContentColorAndOpacity={{ R: 1, G: 1, B: 1, A: 1 }}\n        >\n            <TextBlock\n                Text=\"Hello\"\n                // TextBlock.ColorAndOpacity -> SlateColor (nested)\n                ColorAndOpacity={{\n                    SpecifiedColor: { R: 0.9, G: 0.95, B: 1, A: 1 },\n                }}\n                // TextBlock.ShadowColorAndOpacity -> LinearColor (direct)\n                ShadowColorAndOpacity={{ R: 0, G: 0, B: 0, A: 0.5 }}\n            />\n\n            <Image\n                // Image.ColorAndOpacity -> LinearColor (direct)\n                ColorAndOpacity={{ R: 1, G: 0.5, B: 0.25, A: 1 }}\n            />\n\n            <Button\n                WidgetStyle={{\n                    // WidgetStyle.ForegroundColor -> SlateColor, REQUIRES ColorUseRule: 0\n                    ForegroundColor: {\n                        SpecifiedColor: { R: 0.5, G: 0.5, B: 0.5, A: 1 },\n                        ColorUseRule: 0, // mandatory or the color is ignored\n                    },\n                    FocusedForegroundColor: {\n                        SpecifiedColor: { R: 0.8, G: 0.8, B: 0.9, A: 1 },\n                        ColorUseRule: 0,\n                    },\n                }}\n            />\n        </Border>\n    );\n}\n", 1830) = 1830
