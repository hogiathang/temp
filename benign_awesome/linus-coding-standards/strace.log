53    write(23, "// sample.ts \342\200\224 dummy input for exercising linus-coding-standards skill\ninterface IUserRepo {\n  findById(id: string): User | null;\n}\n\nclass UserRepo implements IUserRepo {\n  findById(id: string): User | null {\n    if (!id) return null;\n    if (typeof id !== 'string') return null;\n    if (id.length === 0) return null;\n    if (id.length > 100) return null;\n    return db.users.get(id);\n  }\n}\n\nfunction calcDamage(a, d, type) {\n  if (type === 'physical') return a.atk - d.def;\n  else if (type === 'magical') return a.matk - d.mdef;\n  else if (type === 'true') return a.atk;\n  else if (type === 'percent') return d.maxHp * 0.1;\n}\n", 629) = 629
