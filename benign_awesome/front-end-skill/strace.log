56    write(22, "\"use client\";\n\n// Sample component exercising front-end-skill guidelines:\n// - Distinctive typography (Bricolage Grotesque + JetBrains Mono, NOT Inter/Roboto)\n// - Dark, cohesive theme via CSS variables; dominant color with sharp accent\n// - framer-motion (`motion`) for a high-impact, staggered NFC tap feedback moment\n// - Tactile feedback for the NFC tap interaction\n// - Loading/error states with visual feedback\nimport { useState } from \"react\";\nimport { AnimatePresence, motion } from \"framer-motion\";\n\ntype TapState = \"idle\" | \"tapping\" | \"settled\" | \"error\";\n\nexport const TapToPayButton = ({ amount = \"24.50\" }: { amount?: string }) => {\n  const [state, setState] = useState<TapState>(\"idle\");\n\n  const simulateTap = () => {\n    setState(\"tapping\");\n    // local-only simulation of an NFC settle round-trip (no network)\n    window.setTimeout(() => setState(\"settled\"), 900);\n  };\n\n  return (\n    <div\n      className=\"flex min-h-[60vh] flex-col items-center justify-center gap-8\"\n      style={{\n        // dominant ink color with a sharp lime accent \342\200\224 drawn from terminal/IDE palettes\n        [\"--ink\" as string]: \"#0a0f0d\",\n        [\"--accent\" as string]: \"#c6ff3a\",\n        background:\n          \"radial-gradient(120% 80% at 50% 0%, #14201a 0%, var(--ink) 60%)\",\n        fontFamily: \"'Bricolage Grotesque', system-ui\",\n      }}\n    >\n      <p\n        className=\"text-sm uppercase tracking-[0.35em] opacity-60\"\n        style={{ fontFamily: \"'JetBrains Mono', monospace\", color: \"var(--accent)\" }}\n      >\n        SplitHub \302\267 tap to settle\n      </p>\n\n      <motion.button\n        onClick={simulateTap}\n        whileTap={{ scale: 0.94 }}\n        animate={state === \"tapping\" ? { scale: [1, 1.06, 1] } : { scale: 1 }}\n        transition={{ duration: 0.45, repeat: state === \"tapping\" ? Infinity : 0 }}\n        className=\"rounded-full px-12 py-6 text-4xl font-black\"\n        style={{ background: \"var(--accent)\", color: \"var(--ink)\" }}\n      >\n        ${amount}\n      </motion.button>\n\n     "..., 2635) = 2635
